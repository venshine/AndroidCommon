<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_padding"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/page_padding"
        android:paddingBottom="24dp">

        <include layout="@layout/include_toolbar" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                style="@style/Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/filter_original" />

                <ImageView
                    android:id="@+id/image_original"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/filter_original" />
            </LinearLayout>

            <Space
                android:layout_width="12dp"
                android:layout_height="0dp" />

            <LinearLayout
                style="@style/Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/filter_name"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/accent_ink" />

                <ImageView
                    android:id="@+id/image_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/filter_result" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/filter_hint"
            style="@style/Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/filter_seek_panel"
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <SeekBar
                android:id="@+id/filter_seek"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:max="255"
                android:progress="127" />

            <TextView
                android:id="@+id/filter_seek_value"
                style="@style/Text.Value"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/filter_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

            <TextView
                android:id="@+id/filter_none"
                style="@style/Chip"
                android:layout_marginStart="0dp"
                android:text="@string/filter_none" />

            <TextView
                android:id="@+id/filter_grey"
                style="@style/Chip"
                android:layout_marginStart="8dp"
                android:text="@string/filter_grey" />

            <TextView
                android:id="@+id/filter_nostalgic"
                style="@style/Chip"
                android:layout_marginStart="8dp"
                android:text="@string/filter_nostalgic" />

            <TextView
                android:id="@+id/filter_film"
                style="@style/Chip"
                android:layout_marginStart="8dp"
                android:text="@string/filter_film" />

            <TextView
                android:id="@+id/filter_soften"
                style="@style/Chip"
                android:layout_marginStart="8dp"
                android:text="@string/filter_soften" />

            <TextView
                android:id="@+id/filter_sharpen"
                style="@style/Chip"
                android:layout_marginStart="8dp"
                android:text="@string/filter_sharpen" />

            <TextView
                android:id="@+id/filter_emboss"
                style="@style/Chip"
                android:layout_marginStart="8dp"
                android:text="@string/filter_emboss" />

            <TextView
                android:id="@+id/filter_sunshine"
                style="@style/Chip"
                android:layout_marginStart="8dp"
                android:text="@string/filter_sunshine" />

            <TextView
                android:id="@+id/filter_saturation"
                style="@style/Chip"
                android:layout_marginStart="8dp"
                android:text="@string/filter_saturation" />

            <TextView
                android:id="@+id/filter_lum"
                style="@style/Chip"
                android:layout_marginStart="8dp"
                android:text="@string/filter_lum" />

            <TextView
                android:id="@+id/filter_hue"
                style="@style/Chip"
                android:layout_marginStart="8dp"
                android:text="@string/filter_hue" />
            </LinearLayout>
        </HorizontalScrollView>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_code"
            android:scrollbars="none">

            <TextView
                android:id="@+id/code_text"
                style="@style/Text.Mono.Code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@null" />
        </HorizontalScrollView>
    </LinearLayout>
</ScrollView>
