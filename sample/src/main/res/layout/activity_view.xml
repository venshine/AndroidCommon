<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_padding"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/page_padding"
        android:paddingBottom="24dp">

        <include layout="@layout/include_toolbar" />

        <!-- AnimatorUtils：抖动 / 呼吸 -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Text.Mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/view_anim_title"
                android:textColor="@color/accent_ink" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="8dp">

                <ImageView
                    android:id="@+id/anim_target"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_logo"
                    android:importantForAccessibility="no"
                    android:padding="14dp"
                    android:src="@drawable/ic_logo"
                    app:tint="@color/on_accent" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_shake"
                    style="@style/Button.Outline"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/view_shake"
                    android:textSize="15sp" />

                <Space
                    android:layout_width="10dp"
                    android:layout_height="0dp" />

                <TextView
                    android:id="@+id/btn_breath"
                    style="@style/Button.Outline"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/view_breath"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ClickUtils：连点 -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Text.Mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/view_click_title"
                android:textColor="@color/accent_ink" />

            <TextView
                android:id="@+id/click_target"
                style="@style/Button"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:text="@string/view_click_target" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/click_taps"
                    style="@style/Text.Value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:textColor="@color/text_muted" />

                <TextView
                    android:id="@+id/click_count"
                    style="@style/Text.Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent_ink" />
            </LinearLayout>

            <TextView
                style="@style/Text.Note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/view_click_hint" />
        </LinearLayout>

        <!-- PictureView -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Text.Mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/view_picture_title"
                android:textColor="@color/accent_ink" />

            <TextView
                style="@style/Text.Note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/view_picture_desc" />

            <TextView
                android:id="@+id/btn_picture"
                style="@style/Button"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:text="@string/view_picture_open" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
