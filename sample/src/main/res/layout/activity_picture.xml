<?xml version="1.0" encoding="utf-8"?>
<!-- PictureView 以屏幕尺寸为基准居中，所以这一页不留系统栏内边距，铺满整个屏幕 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/code_bg">

    <com.wx.android.common.widget.PictureView
        android:id="@+id/picture_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/view_picture_title" />

    <LinearLayout
        android:id="@+id/picture_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/picture_hint"
            style="@style/Text.Mono"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/picture_hint"
            android:textColor="@color/text_muted" />

        <TextView
            android:id="@+id/picture_scale"
            style="@style/Text.Mono.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/picture_close"
        style="@style/IconButton.Boxed"
        android:layout_gravity="top|start"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:contentDescription="@string/back"
        android:src="@drawable/ic_back" />
</FrameLayout>
